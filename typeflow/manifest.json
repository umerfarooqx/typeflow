{
  "name": "TypeFlow — Typing Tutor",
  "short_name": "TypeFlow",
  "description": "A comprehensive typing tutor with stats, adaptive drills, and multiple themes.",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "background_color": "#0f1115",
  "theme_color": "#0f1115",
  "orientation": "any",
  "icons": [
    { "src": "icons/icon-192.svg", "sizes": "192x192", "type": "image/svg+xml" },
    { "src": "icons/icon-512.svg", "sizes": "512x512", "type": "image/svg+xml" },
    { "src": "icons/icon-maskable-512.svg", "sizes": "512x512", "type": "image/svg+xml", "purpose": "maskable" }
  ],
  "file_handlers": [
    { "action": "./index.html", "accept": { "text/plain": [".txt"] } }
  ],
  "share_target": {
    "action": "./index.html",
    "method": "GET",
    "params": { "title": "title", "text": "text", "url": "url" }
  },
  "shortcuts": [
    { "name": "Quick practice", "url": "./index.html#practice" },
    { "name": "Stats", "url": "./index.html#stats" }
  ]
}